{
  "expo": {
    "name": "ZEDX",
    "slug": "SyntaxLibrary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/zedx-icon.png",
    "scheme": "zedx",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lumin0us.zedx",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e0a12",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lumin0us.zedx"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/zedx-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/zedx-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0e0a12"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8d55ff28-0a20-4de5-9740-9c9d48b2266f"
      }
    }
  }
}
